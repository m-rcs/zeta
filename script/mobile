#!/usr/bin/env bash
set -euo pipefail

# script/mobile — cross-build, launch, and check zed_mobile for iOS and Android.
#
# Usage:
#   script/mobile check
#   script/mobile build  ios     [--release]
#   script/mobile build  android [--release]
#   script/mobile launch ios     [--release] [--device <name>]
#   script/mobile launch android [--release] [--device <serial>]
#
# Prerequisites (one-time):
#   - Rust targets: rustup target add aarch64-apple-ios-sim aarch64-linux-android
#   - iOS:        Xcode + xcodegen (brew install xcodegen)
#   - Android:    cargo-ndk (cargo install cargo-ndk)
#                 NDK r29+ (brew install --cask android-ndk)
#                 OpenJDK 17 (brew install openjdk@17)
#                 Android command-line tools (brew install --cask android-commandlinetools)

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
ZED_MOBILE_DIR="$PROJECT_DIR/crates/zed_mobile"
IOS_PROJECT_DIR="$PROJECT_DIR/mobile/ios"
ANDROID_PROJECT_DIR="$PROJECT_DIR/mobile/android"

IOS_TARGET="aarch64-apple-ios-sim"
ANDROID_TARGET="aarch64-linux-android"
ANDROID_PLATFORM="26"

RELEASE=false
DEVICE=""

# ---- helpers ----

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

info()  { echo -e "${GREEN}==>${NC} $*"; }
warn()  { echo -e "${YELLOW}==>${NC} $*"; }
error() { echo -e "${RED}==>${NC} $*" >&2; }

die() { error "$@"; exit 1; }

usage() {
  sed -n '/^# Usage:/,/^$/p' "$0" | sed 's/^# //'
  exit 0
}

# ---- ndk discovery ----

resolve_ndk_home() {
  if [[ -n "${ANDROID_NDK_HOME:-}" && -d "$ANDROID_NDK_HOME" ]]; then
    echo "$ANDROID_NDK_HOME"
    return 0
  fi
  if [[ -n "${ANDROID_NDK_ROOT:-}" && -d "$ANDROID_NDK_ROOT" ]]; then
    echo "$ANDROID_NDK_ROOT"
    return 0
  fi
  local props="$ANDROID_PROJECT_DIR/local.properties"
  if [[ -f "$props" ]]; then
    local ndk_dir
    ndk_dir=$(grep -E '^ndk\.dir\s*=' "$props" 2>/dev/null | sed 's/^ndk\.dir\s*=\s*//' | xargs || true)
    if [[ -n "${ndk_dir:-}" && -d "$ndk_dir" ]]; then
      echo "$ndk_dir"
      return 0
    fi
  fi
  # Try common Homebrew paths
  for dir in /opt/homebrew/share/android-ndk /usr/local/share/android-ndk; do
    if [[ -d "$dir" ]]; then
      echo "$dir"
      return 0
    fi
  done
  return 1
}

require_ndk() {
  local ndk
  if ! ndk=$(resolve_ndk_home); then
    die "Android NDK not found. Install with: brew install --cask android-ndk"
  fi
  export ANDROID_NDK_HOME="$ndk"
}

# ---- check ----

check_ios() {
  info "Checking zed_mobile for iOS simulator..."
  (cd "$PROJECT_DIR" && cargo check -p zed_mobile --target "$IOS_TARGET")
}

check_android() {
  require_ndk
  info "Checking zed_mobile for Android..."
  (cd "$PROJECT_DIR" && cargo ndk -t arm64-v8a -P "$ANDROID_PLATFORM" check -p zed_mobile)
}

cmd_check() {
  check_ios
  check_android
  info "Both platforms checked successfully."
}

# ---- build ----

build_flag() {
  if $RELEASE; then echo "--release"; else echo ""; fi
}

xcode_config() {
  if $RELEASE; then echo "Release"; else echo "Debug"; fi
}

# Returns the .app path after a successful xcodebuild.
build_ios() {
  local flag; flag=$(build_flag)
  info "Building zed_mobile (Rust, iOS) ${flag}..."
  (cd "$PROJECT_DIR" && cargo build -p zed_mobile --target "$IOS_TARGET" $flag)

  info "Generating Xcode project..."
  (cd "$IOS_PROJECT_DIR" && xcodegen generate)

  local config; config=$(xcode_config)
  info "Building Xcode project (${config})..."
  (cd "$IOS_PROJECT_DIR" && xcodebuild \
    -project ZedMobile.xcodeproj \
    -scheme ZedMobile \
    -sdk iphonesimulator \
    -destination "generic/platform=iOS Simulator" \
    CODE_SIGNING_ALLOWED=NO \
    CODE_SIGNING_REQUIRED=NO \
    -configuration "$config" \
    build) || die "xcodebuild failed"

  local derived_data
  derived_data=$(ls -dt "$HOME/Library/Developer/Xcode/DerivedData/ZedMobile-"* 2>/dev/null | head -1)
  if [[ -z "$derived_data" ]]; then
    die "Could not find DerivedData for ZedMobile."
  fi
  echo "${derived_data}/Build/Products/${config}-iphonesimulator/ZedMobile.app"
}

build_android() {
  require_ndk
  local flag; flag=$(build_flag)
  info "Building zed_mobile (Rust, Android) ${flag}..."
  (cd "$PROJECT_DIR" && cargo ndk -t arm64-v8a -P "$ANDROID_PLATFORM" --link-libcxx-shared build -p zed_mobile $flag)

  local gradle_flag=""
  if $RELEASE; then gradle_flag="-PrustRelease"; fi
  info "Assembling APK..."
  (cd "$ANDROID_PROJECT_DIR" && ./gradlew $gradle_flag assembleDebug)
}

cmd_build() {
  local platform="${1:-}"
  case "$platform" in
    ios)     build_ios > /dev/null && info "iOS build complete." ;;
    android) build_android > /dev/null && info "Android build complete." ;;
    *)       die "Expected 'ios' or 'android', got '$platform'" ;;
  esac
}

# ---- launch ----

resolve_ios_device() {
  if [[ -n "$DEVICE" ]]; then
    local id
    id=$(xcrun simctl list devices available | grep -w "$DEVICE" | head -1 | sed -E 's/.*\(([A-F0-9-]+)\).*/\1/')
    if [[ -z "$id" ]]; then
      die "iOS simulator '$DEVICE' not found. Available:"
      xcrun simctl list devices available | grep -E 'iPhone|iPad' | sed 's/^/  /'
      exit 1
    fi
    echo "$id"
  else
    xcrun simctl list devices available | grep -m1 'iPhone' | sed -E 's/.*\(([A-F0-9-]+)\).*/\1/'
  fi
}

launch_ios() {
  local app_path; app_path=$(build_ios)
  local device_id; device_id=$(resolve_ios_device)

  info "Booting simulator $device_id..."
  xcrun simctl boot "$device_id" 2>/dev/null || true
  # Wait for boot to complete
  xcrun simctl bootstatus "$device_id" -b 2>/dev/null || true

  info "Installing app..."
  xcrun simctl install "$device_id" "$app_path"

  info "Launching..."
  xcrun simctl launch --console "$device_id" dev.zed.mobile
}

launch_android() {
  build_android

  local serial_flag=""
  if [[ -n "$DEVICE" ]]; then
    serial_flag="-s $DEVICE"
  fi

  info "Installing APK..."
  local apk
  apk=$(find "$ANDROID_PROJECT_DIR/app/build/outputs/apk/debug" -name "*.apk" | head -1)
  if [[ -z "$apk" ]]; then
    die "APK not found after build"
  fi
  adb $serial_flag install -r "$apk"

  info "Launching..."
  adb $serial_flag shell am start -n dev.zed.mobile/android.app.NativeActivity

  info "Logcat (Ctrl-C to stop)..."
  adb $serial_flag logcat -s "zed_mobile:V" "gpui_mobile:V" "RustStdoutStderr:V"
}

cmd_launch() {
  local platform="${1:-}"
  case "$platform" in
    ios)     launch_ios ;;
    android) launch_android ;;
    *)       die "Expected 'ios' or 'android', got '$platform'" ;;
  esac
}

# ---- main ----

while [[ $# -gt 0 ]]; do
  case "$1" in
    --release) RELEASE=true; shift ;;
    --device)  DEVICE="${2:-}"; shift 2 ;;
    -h|--help) usage ;;
    *) break ;;
  esac
done

CMD="${1:-}"
shift || true

case "$CMD" in
  check)  cmd_check ;;
  build)  cmd_build "${1:-}" ;;
  launch) cmd_launch "${1:-}" ;;
  *)      usage ;;
esac
