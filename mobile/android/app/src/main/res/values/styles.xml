<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      windowBackground matches the Rust-side RootView color so there's no
      flash between activity launch and the first wgpu frame.
    -->
    <style name="ZedTheme" parent="@android:style/Theme.NoTitleBar">
        <item name="android:windowBackground">@color/zed_surface</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:hardwareAccelerated">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:statusBarColor">@color/zed_surface</item>
        <item name="android:navigationBarColor">@color/zed_surface</item>
        <item name="android:windowContentTransitions">false</item>
    </style>
</resources>
